{
    "name": "wasm-raf-handler-demo",
    "version": "0.1.0",
    "description": "Demo Crate for handling `requestAnimationFrame` loops",
    "private": true,
    "main": "index.js",
    "scripts": {
        "start:rust": "cross-env CHOKIDAR_USEPOLLING=1 chokidar 'Cargo.toml' 'src/**/*.rs' '../src/**/*.rs' -c 'npm run build:rust'",
        "start:web": "webpack serve --mode development",
        "build:web": "webpack --mode production",
        "build:rust": "wasm-pack build --target bundler --out-dir pkg",
        "build": "npm-run-all build:rust build:web",
        "start": "npm-run-all build:rust --parallel start:rust start:web"
    },
    "keywords": [
        "webassembly",
        "wasm",
        "rust",
        "webpack"
    ],
    "author": "Andydevs",
    "license": "MIT",
    "dependencies": {
        "wasm-raf-handler-demo": "file:pkg/wasm_raf_handler_demo.js"
    },
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "cross-env": "^10.1.0",
        "npm-run-all": "^4.1.5",
        "copy-webpack-plugin": "^14.0.0",
        "wasm-loader": "^1.3.0",
        "webpack": "^5.105.4",
        "webpack-cli": "^7.0.0",
        "webpack-dev-server": "^5.2.3"
    }
}